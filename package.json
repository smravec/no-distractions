{
  "name": "no-distractions",
  "description": "Browser extension that removes distracting reels, shorts, and suggested posts.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:browser": "node scripts/dev-browser.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
  },
  "dependencies": {
    "@fontsource/reddit-sans": "^5.2.7"
  }
}
